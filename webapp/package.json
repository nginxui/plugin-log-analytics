{
  "name": "plugin-log-analytics-webapp",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Webapp bundle for the NGINX UI log analytics plugin: log list columns, structured search and the traffic dashboard",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && vite build -c vite.search.config.ts && vite build -c vite.dashboard.config.ts",
    "i18n": "bun scripts/extract-translations.ts",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "bun test tests",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@nginxui/plugin-sdk": "file:../../plugin-sdk-web",
    "apexcharts": "^7.5.1",
    "dayjs": "^1.11.23",
    "echarts": "^6.1.0",
    "i18n-iso-countries": "^7.14.0",
    "vue-echarts": "^8.3.0",
    "vue3-apexcharts": "1.6.0"
  },
  "devDependencies": {
    "@antdv-next/icons": "^1.1.2",
    "@antfu/eslint-config": "^9.5.1",
    "@happy-dom/global-registrator": "^20.14.5",
    "@types/bun": "^1.3.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/tsconfig": "^0.9.1",
    "@vueuse/core": "15.0.0",
    "antdv-next": "1.5.4",
    "eslint": "^10.11.0",
    "happy-dom": "^20.14.5",
    "pinia": "4.0.3",
    "typescript": "^5.9.3",
    "unocss": "^66.10.5",
    "vite": "^7.0.0",
    "vue": "3.5.42",
    "vue-router": "5.3.1",
    "vue-tsc": "^3.3.11"
  }
}
